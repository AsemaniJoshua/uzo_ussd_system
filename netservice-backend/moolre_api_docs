# Flask USSD Handler
from flask import Flask, request, jsonify

app = Flask(__name__)
sessions = {}

@app.route('/ussd', methods=['POST'])
def ussd_handler():
    data = request.json
    session_id = data.get('sessionid')
    msg = data.get('message')
    is_new = data.get('new')
    
    if is_new:
        sessions[session_id] = {'stage': 'HOME'}
        return jsonify({
            "message": "Welcome Service\n1. My Info\n2. Subscribe",
            "reply": True
        })
        
    stage = sessions.get(session_id, {}).get('stage')
    
    if stage == 'HOME':
        if msg == '1':
            return jsonify({ "message": "You are John Doe", "reply": False })
        elif msg == '2':
            sessions[session_id]['stage'] = 'SUB'
            return jsonify({ "message": "Choose Plan:\n1. Daily\n2. Weekly", "reply": True })
            
    elif stage == 'SUB':
        plan = "Daily" if msg == '1' else "Weekly"
        return jsonify({ 
            "message": f"You subscribed to {plan} plan.", 
            "reply": False 
        })
        
    return jsonify({ "message": "Error", "reply": False })
Tips & Tricks
Timeout Handling: USSD sessions time out quickly (usually 30-60 seconds). Keep your API response times under 2 seconds.
Character Limits: USSD screens vary by device. Keep your message concise (under 160 chars) to ensure it displays correctly on all phones.
Pagination: For long lists, implement a "Press 9 for more" logic to handle pagination manually within your state machine.