# --------------------------------------------------------------------------------------------
# Second Gemini Config
# --------------------------------------------------------------------------------------------

# Disable directory listing and MultiViews to prevent routing conflicts
Options -Indexes -MultiViews

RewriteEngine On

# 1. THE 403 FIX: If a directory is requested but a .html file exists with that name,
# prioritize and serve the .html file.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# 2. Handle trailing slashes: redirect /path/ to /path for consistency 
# (only if a .html file exists to handle it)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 3. Allow Next.js internal static files through immediately
RewriteRule ^_next/static/ - [L]

# 4. Serve the file if it exactly matches an existing file
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. SPA FALLBACK: If the route is not a file or a direct .html match,
# let the main index handle it.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 6. Error handling
ErrorDocument 404 /404.html

